diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index e5b23f2..aa19f3d 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -266,11 +266,64 @@ _cnputc(char c, bool poll)
  *             waiting for an interrupt when the hardware device isn't ready
  * @param size The number of characters to print to the console.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Mirror console output into the pmsg ring so kernel printf and userspace
+ * /dev/console writes (e.g. sweet-init's heartbeat) are readable from Android
+ * after a reset. Only post-VM-switch output is captured (KVA alias live). */
+extern unsigned int sweet_pmsg_kva_live;
+#define SWEET_PMSG_KVA 0xFFFFFE0200130000UL
+static void
+sweet_console_mark(const char *c, int size)
+{
+	if (!sweet_pmsg_kva_live || size <= 0) {
+		return;
+	}
+	volatile unsigned int *base = (volatile unsigned int *)SWEET_PMSG_KVA;
+	unsigned int used = base[2];
+	unsigned int nwords = ((unsigned int)size + 3u) / 4u;
+	if (nwords > 16u) {
+		nwords = 16u;
+	}
+	unsigned int recbytes = 16u + nwords * 4u;
+	if (used > 0x40000u - recbytes - 32u) {
+		return;
+	}
+	volatile unsigned int *r = (volatile unsigned int *)(SWEET_PMSG_KVA + 12u + used);
+	unsigned int w[16];
+	unsigned int i;
+	for (i = 0; i < 16u; i++) {
+		w[i] = 0;
+	}
+	for (i = 0; i < (unsigned int)size && i < 64u; i++) {
+		w[i / 4u] |= ((unsigned int)(unsigned char)c[i]) << ((i % 4u) * 8u);
+	}
+	unsigned int x = 0;
+	for (i = 0; i < nwords; i++) {
+		r[4u + i] = w[i];
+		x ^= w[i];
+	}
+	r[0] = (unsigned int)'C' | ((unsigned int)'O' << 8) | ((unsigned int)'N' << 16) | ((unsigned int)'S' << 24);
+	r[1] = used;
+	r[2] = nwords;
+	r[3] = x;
+	__asm__ volatile("dc civac, %0" :: "r"(r) : "memory");
+	__asm__ volatile("dc civac, %0" :: "r"((unsigned long)r + 64u) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+	base[2] = used + recbytes;
+	__asm__ volatile("dc civac, %0" :: "r"(base) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif
+
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
 	extern int disableConsoleOutput;
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_console_mark(c, size);
+#endif
+
 	if (disableConsoleOutput) {
 		return;
 	}
