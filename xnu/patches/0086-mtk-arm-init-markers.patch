+#if defined(SWEET)
+/*
+ * Early-boot pmsg marker. Appends one record to the ramoops pmsg zone at
+ * VA 0x48130000, reachable through the V=P alias installed by start.s
+ * (live until arm_vm_init replaces the bootstrap tables). Same record
+ * format as the shim and SWEET_PMSG_MARK: 16B header {tag,seq,n,xor} + 1
+ * data word. No locks, no allocation, safe before console/cpu_data exist.
+ */
+#define SWEET_EARLY_TAG(a, b, c, d) \
+	((unsigned int)(a) | ((unsigned int)(b) << 8) | \
+	 ((unsigned int)(c) << 16) | ((unsigned int)(d) << 24))
+static void
+sweet_early_mark(unsigned int tag, unsigned int val)
+{
+	volatile unsigned int *base = (volatile unsigned int *)0x48130000UL;
+	unsigned int size = base[2];
+	if (size > 0x40000u - 32u) {
+		return;
+	}
+	volatile unsigned int *r =
+	    (volatile unsigned int *)(0x48130000UL + 12u + size);
+	r[4] = val;
+	r[0] = tag;
+	r[1] = size;
+	r[2] = 1u;
+	r[3] = val;
+	__asm__ volatile("dc civac, %0" :: "r"(r) : "memory");
+	__asm__ volatile("dc civac, %0" :: "r"((unsigned long)r + 64u) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+	base[2] = size + 20u;
+	__asm__ volatile("dc civac, %0" :: "r"(base) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* SWEET */
