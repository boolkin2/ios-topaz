 	us = NULL;
@@ -3054,6 +3055,7 @@
 	if (!message) {
 		return kIOReturnIPCError;
 	}
+	rpc.kernelContent = message;
 
 	if (OSObject_Instantiate_ID == message->msgid) {
 		ret = objectInstantiate(obj, rpc, message);
