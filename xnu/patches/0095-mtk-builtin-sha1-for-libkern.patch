diff --git a/libkern/crypto/corecrypto_sha1.c b/libkern/crypto/corecrypto_sha1.c
index 5fd982b..8efae0e 100644
--- a/libkern/crypto/corecrypto_sha1.c
+++ b/libkern/crypto/corecrypto_sha1.c
@@ -3,6 +3,121 @@
 #include <kern/debug.h>
 #include <corecrypto/ccdigest.h>
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET has no corecrypto kext, so g_crypto_funcs stays NULL and there is no
+ * built-in ccsha1_ltc_di provider either (only SHA-256 was backported, patch
+ * 0023). generatePlatformUUID() calls SHA1 during ConfigureIOKit, which used to
+ * dereference the NULL g_crypto_funcs and fault. Provide a self-contained
+ * SHA-1 (RFC 3174) operating on the legacy SHA1_CTX, no corecrypto dependency.
+ */
+#include <libkern/libkern.h>
+
+#define SWEET_SHA1_ROL(x, n) (((x) << (n)) | ((x) >> (32 - (n))))
+
+static void
+sweet_sha1_transform(uint32_t state[5], const uint8_t block[64])
+{
+	uint32_t w[80];
+	uint32_t a, b, c, d, e;
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		w[i] = ((uint32_t)block[i * 4] << 24) |
+		    ((uint32_t)block[i * 4 + 1] << 16) |
+		    ((uint32_t)block[i * 4 + 2] << 8) |
+		    ((uint32_t)block[i * 4 + 3]);
+	}
+	for (i = 16; i < 80; i++) {
+		w[i] = SWEET_SHA1_ROL(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+	}
+
+	a = state[0]; b = state[1]; c = state[2]; d = state[3]; e = state[4];
+	for (i = 0; i < 80; i++) {
+		uint32_t f, k, temp;
+		if (i < 20) {
+			f = (b & c) | ((~b) & d); k = 0x5A827999u;
+		} else if (i < 40) {
+			f = b ^ c ^ d; k = 0x6ED9EBA1u;
+		} else if (i < 60) {
+			f = (b & c) | (b & d) | (c & d); k = 0x8F1BBCDCu;
+		} else {
+			f = b ^ c ^ d; k = 0xCA62C1D6u;
+		}
+		temp = SWEET_SHA1_ROL(a, 5) + f + e + k + w[i];
+		e = d; d = c; c = SWEET_SHA1_ROL(b, 30); b = a; a = temp;
+	}
+	state[0] += a; state[1] += b; state[2] += c; state[3] += d; state[4] += e;
+}
+
+void
+SHA1Init(SHA1_CTX *ctx)
+{
+	ctx->h.b32[0] = 0x67452301u;
+	ctx->h.b32[1] = 0xEFCDAB89u;
+	ctx->h.b32[2] = 0x98BADCFEu;
+	ctx->h.b32[3] = 0x10325476u;
+	ctx->h.b32[4] = 0xC3D2E1F0u;
+	ctx->c.b64[0] = 0;   /* total byte count */
+	ctx->count = 0;
+}
+
+void
+SHA1Update(SHA1_CTX *ctx, const void *data, size_t len)
+{
+	const uint8_t *p = (const uint8_t *)data;
+	uint64_t bytes = ctx->c.b64[0];
+	size_t fill = (size_t)(bytes & 63u);
+
+	ctx->c.b64[0] = bytes + len;
+	if (fill) {
+		size_t need = 64u - fill;
+		if (len < need) {
+			memcpy(ctx->m.b8 + fill, p, len);
+			return;
+		}
+		memcpy(ctx->m.b8 + fill, p, need);
+		sweet_sha1_transform(ctx->h.b32, ctx->m.b8);
+		p += need;
+		len -= need;
+	}
+	while (len >= 64u) {
+		sweet_sha1_transform(ctx->h.b32, p);
+		p += 64u;
+		len -= 64u;
+	}
+	if (len) {
+		memcpy(ctx->m.b8, p, len);
+	}
+}
+
+void
+SHA1Final(void *digest, SHA1_CTX *ctx)
+{
+	uint64_t bits = ctx->c.b64[0] * 8u;
+	size_t fill = (size_t)(ctx->c.b64[0] & 63u);
+	uint8_t pad[72];
+	size_t padlen;
+	uint8_t *out = (uint8_t *)digest;
+	int i;
+
+	pad[0] = 0x80u;
+	memset(pad + 1, 0, sizeof(pad) - 1);
+	padlen = (fill < 56u) ? (56u - fill) : (120u - fill);
+	for (i = 0; i < 8; i++) {
+		pad[padlen + i] = (uint8_t)(bits >> (56 - 8 * i));
+	}
+	SHA1Update(ctx, pad, padlen + 8u);
+
+	for (i = 0; i < 5; i++) {
+		out[i * 4]     = (uint8_t)(ctx->h.b32[i] >> 24);
+		out[i * 4 + 1] = (uint8_t)(ctx->h.b32[i] >> 16);
+		out[i * 4 + 2] = (uint8_t)(ctx->h.b32[i] >> 8);
+		out[i * 4 + 3] = (uint8_t)(ctx->h.b32[i]);
+	}
+}
+
+#else /* !ARM64_BOARD_CONFIG_SWEET */
 
 static uint64_t
 getCount(SHA1_CTX *ctx)
@@ -69,6 +184,8 @@ SHA1Final(void *digest, SHA1_CTX *ctx)
 	ccdigest_final(di, di_ctx, digest);
 }
 
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 /* This is not publicised in header, but exported in libkern.exports */
 void SHA1Final_r(SHA1_CTX *context, void *digest);
 void
@@ -106,4 +223,4 @@ sha1_hardware_hook(Boolean option, InKernelPerformSHA1Func func, void *ref)
 		performSHA1WithinKernelOnly = NULL;
 		SHA1Ref = NULL;
 	}
-}
+}
\ No newline at end of file
