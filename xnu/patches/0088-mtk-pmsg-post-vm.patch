diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
--- a/osfmk/arm/arm_init.c	2026-11-11 23:37:57.574799400 +0500
+++ b/osfmk/arm/arm_init.c	2026-11-11 23:41:00.548650800 +0500
@@ -348,6 +348,40 @@
 	__asm__ volatile("dc civac, %0" :: "r"(base) : "memory");
 	__asm__ volatile("dsb sy" ::: "memory");
 }
+
+/*
+ * Post-arm_vm_init pmsg marker (patch 0088). Once arm_vm_init() calls
+ * set_mmu_ttb(invalid_ttep) the bootstrap V=P alias at 0x48130000 is gone.
+ * arm_vm_init() re-installs the pmsg block into the new kernel page tables
+ * at KVA 0xFFFFFE0200000000 (PA 0x48000000), so from the table switch onward
+ * the zone lives at 0xFFFFFE0200130000. Identical record format to
+ * sweet_early_mark; the physical zone (and its size/seq) is the same, so
+ * markers stay contiguous across the switch. Non-static: arm_vm_init.c
+ * calls it immediately after the switch.
+ */
+#define SWEET_PMSG_KVA 0xFFFFFE0200130000UL
+void
+sweet_late_mark(unsigned int tag, unsigned int val)
+{
+	volatile unsigned int *base = (volatile unsigned int *)SWEET_PMSG_KVA;
+	unsigned int size = base[2];
+	if (size > 0x40000u - 32u) {
+		return;
+	}
+	volatile unsigned int *r =
+	    (volatile unsigned int *)(SWEET_PMSG_KVA + 12u + size);
+	r[4] = val;
+	r[0] = tag;
+	r[1] = size;
+	r[2] = 1u;
+	r[3] = val;
+	__asm__ volatile("dc civac, %0" :: "r"(r) : "memory");
+	__asm__ volatile("dc civac, %0" :: "r"((unsigned long)r + 64u) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+	base[2] = size + 20u;
+	__asm__ volatile("dc civac, %0" :: "r"(base) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
 #endif /* SWEET */
 
 /*
@@ -613,6 +647,11 @@
 #endif
