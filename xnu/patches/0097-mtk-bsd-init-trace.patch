diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 4df41ba..6ccd9a4 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -492,8 +492,20 @@ bsd_init(void)
 
 #define DEBUG_BSDINIT 0
 
+#if defined(SWEET)
+/* Patch 0097: trace bsd_init via the (otherwise disabled) bsd_init_kprintf macro.
+ * Each call site emits a pmsg record whose value is the source __LINE__, so the
+ * last marker pinpoints the exact stall line. pmsg KVA alias is live by bsd_init. */
+extern void sweet_late_mark(unsigned int tag, unsigned int val);
+#define SWEET_BSD_TAG(a, b, c, d) \
+	((unsigned int)(a) | ((unsigned int)(b) << 8) | \
+	 ((unsigned int)(c) << 16) | ((unsigned int)(d) << 24))
+#endif
+
 #if DEBUG_BSDINIT
 #define bsd_init_kprintf(x, ...) kprintf("bsd_init: " x, ## __VA_ARGS__)
+#elif defined(SWEET)
+#define bsd_init_kprintf(x, ...) sweet_late_mark(SWEET_BSD_TAG('B','S','D','0'), (unsigned int)__LINE__)
 #else
 #define bsd_init_kprintf(x, ...)
 #endif
@@ -1075,6 +1087,9 @@ bsdinit_task(void)
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+#if defined(SWEET)
+	sweet_late_mark(SWEET_BSD_TAG('L','D','0','0'), 0);
+#endif
 	load_init_program(p);
 	lock_trace = 1;
 }
